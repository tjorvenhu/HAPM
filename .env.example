# Alle Angaben sind freiwillig. Ohne diese Datei läuft HAPM mit den Vorgaben.

# Port der Oberfläche auf dem Server.
HAPM_PORT=7080

# Adresse, auf der die Oberfläche lauscht. Mit 127.0.0.1 ist sie nur noch über
# HAProxy erreichbar (Ziel 127.0.0.1:7080), nicht mehr direkt von außen.
HAPM_BIND=0.0.0.0

# Ordner auf dem Server, in dem alle Daten liegen: Konfiguration, Zertifikate,
# Datenbank. Ohne Angabe `data` neben docker-compose.yml. Nach dem ersten Start
# nur ändern, wenn der Ordner vorher mit umgezogen ist.
# HAPM_STORAGE=/opt/hapm/data

# Zeitzone für Zeitangaben und die Uhrzeit selbsttätiger Updates.
TZ=Europe/Berlin

# Zertifizierungsstelle: letsencrypt, letsencrypt_test (Staging, zum Ausprobieren),
# zerossl oder die Adresse eines ACME-Verzeichnisses.
HAPM_ACME_SERVER=letsencrypt

# Datenbank. Im Compose-Stack ist nichts einzutragen: HAPM erreicht Postgres über
# den Socket im geteilten Ordner. Nur für abweichende Aufbauten.
# HAPM_DATABASE_SOCKET=/var/run/postgresql
# HAPM_DATABASE_NAME=hapm
# HAPM_DATABASE_USER=hapm
# HAPM_POSTGRES_CONTAINER=hapm-postgres

# Abbilder. `haproxy:lts` folgt dem Langzeit-Zweig, `haproxy:latest` dem neuesten.
HAPROXY_IMAGE=haproxy:lts
HAPM_IMAGE=ghcr.io/tjorvenhu/hapm:latest

# CrowdSec (WAF) gehört zum Stack, prüft aber nichts, bis es in der Oberfläche
# eingeschaltet wird. Mit 1 gibt es CrowdSec gar nicht: Compose holt die Abbilder
# nicht und legt keine Container an. Läuft es schon, danach:
# docker compose rm -sf crowdsec crowdsec-bouncer
# HAPM_CROWDSEC_OFF=1

# Port, auf dem HAProxy den Bouncer von CrowdSec erreicht (nur 127.0.0.1).
# HAPM_SPOA_PORT=7423
